# Dependencies and generated output (keep package-lock.json tracked)
node_modules/
dist/
coverage/
*.tsbuildinfo

# Local credentials; sanitized examples may be committed
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.key
*.pem
*.p12
*.pfx
.npmrc.local

# Machine-specific connector, agent and tunnel state
/.continue/
/bin/tunnel-client
/bin/tunnel-client.exe
/.gsa/local-state/
/.codex/*.local.toml
/.codex/cache/
/.codex/sessions/

# Agent environment and Codex-only workflow stay local
/.codex/
/.agents/
/harness/
/AGENTS.md
/TASKS.md
/lessons/
/docs/bootstrap/
/docs/CLI-HANDOFF.md
/docs/reports/
/.gsa/BASELINE.md
/.gsa/CURRENT_CHECKPOINT.md
# Do not ignore product workflow definitions such as .gsa/ci.yaml.
# Product build/install/native-test scripts in scripts/ remain versioned.

# VM media and runtime state; keep native source and entitlements tracked
*.raw
*.qcow2
*.vhd
*.vhdx
*.vmdk
*.iso
*.nvram
*.efivars
*.dmg
*.sparseimage
*.sparsebundle/

# Logs and language/tool caches
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.build/
.swiftpm/
.DS_Store
._*
