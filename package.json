{
  "name": "gsa-localconnector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Machine-first local MCP connector for GSA",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run test",
    "mcp": "node dist/src/mcp/cli.js",
    "mcp:http": "node dist/src/mcp/http-cli.js",
    "prepare": "node dist/src/local/prepare.js",
    "workspace": "node dist/src/local/workspace-cli.js",
    "native:probe": "npm run build && node dist/src/local/native-capability-probe.js",
    "native:policy:mac": "npm run build && node scripts/native-policy-macos.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
