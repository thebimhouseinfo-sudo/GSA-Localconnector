{
  "version": 1,
  "target": "main",
  "push": "MANUAL_ONLY",
  "mode": "GUIDED_ONLY",
  "maxReviewRounds": 2,
  "maxStopAttempts": 3,
  "sensitive": ["src/local/grants", "src/local/control-lease", "src/local/identity", "src/local/protected-state", "src/local/process-store", "src/hosts/", "native/", "scripts/install-", "scripts/mac-package", "src/mcp/http", ".codex/", "harness/"],
  "quickCommands": [["node", "harness/self-check.mjs"], ["node", "node_modules/typescript/bin/tsc", "-p", "tsconfig.json", "--noEmit"]],
  "commands": [["node", "harness/self-check.mjs"], ["node", "--test", "harness/test/harness.test.mjs"], ["npm", "test"]]
}
